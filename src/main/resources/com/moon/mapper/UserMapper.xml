<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moon.mapper.UserMapper">
    <select id="search" resultType="com.moon.domain.vo.UserVO">
        select id, username, user_account, gender, img_url, phone, email, role, status, create_time, update_time from user
        <where>
            <if test="username!=''||username!=null">username=#{username}</if>
        </where>
    </select>
</mapper>
